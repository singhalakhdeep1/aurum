# ---------- Required ----------

# PostgreSQL (Neon, Supabase, local...). DIRECT_URL is used by Prisma migrations;
# for a plain local database both can be the same string.
DATABASE_URL=postgresql://user:password@localhost:5432/aurum?schema=public
DIRECT_URL=postgresql://user:password@localhost:5432/aurum?schema=public

# Clerk (authentication) - https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
# Svix signing secret of the Clerk webhook (endpoint: /api/webhooks/clerk)
CLERK_WEBHOOK_SECRET=

# Public URL of the app (used for Plaid/Stripe callbacks). Must be https for Plaid webhooks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Features (each one is disabled until its keys are set) ----------

# AI receipt scanning and monthly report insights - https://aistudio.google.com
GEMINI_API_KEY=

# Email (budget alerts, monthly reports) - https://resend.com
RESEND_API_KEY=

# Bank feeds via Plaid - https://dashboard.plaid.com (PLAID_ENV: sandbox | development | production)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Encrypts Plaid access tokens at rest. 32 random bytes, hex encoded:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BANK_TOKEN_KEY=

# Web push notifications. Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Rate limiting and bot protection - https://arcjet.com (optional, skipped when empty)
ARCJET_KEY=

# Crypto wallet balances: optional custom RPC endpoints (public defaults are used when empty)
ETHEREUM_RPC_URL=
POLYGON_RPC_URL=
BSC_RPC_URL=

# Stripe Checkout API (/api/billing) - optional
STRIPE_SECRET_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
